# qblot.env.example
# Copy this file to qblot.env and fill in your credentials

# IBM Quantum Credentials
# Get these from: https://quantum.ibm.com/
export IBM_CLOUD_API_KEY="your_api_key_here"
export IBM_QUANTUM_CRN="crn:v1:bluemix:public:quantum-computing:us-east:a/YOUR_ACCOUNT:YOUR_INSTANCE::"
export QISKIT_IBM_RUNTIME_INSTANCE="crn:v1:bluemix:public:quantum-computing:us-east:a/YOUR_ACCOUNT:YOUR_INSTANCE::"

# Default QFT Settings
DEFAULT_BACKEND=ibm_torino
DEFAULT_SHOTS=8000

# Optional: HuggingFace token for Qwen embeddings
# export HF_TOKEN="hf_..."

# ===================================
# Available IBM Quantum Backends
# ===================================
# ibm_torino    - 127 qubits (recommended)
# ibm_brisbane  - 133 qubits
# ibm_osaka     - 127 qubits
# ibm_kyoto     - 127 qubits
# ibm_cusco     - 127 qubits
#
# Check current status: https://quantum.ibm.com/services/resources

# ===================================
# Pipeline Configuration Notes
# ===================================
# Target Dimension: 768 (requires 17 qubits after pow2 padding)
# Sparsity: 0.7 (70% of components zeroed per vector)
# Optimization Level: 1 (Qiskit transpiler)
#
# These are hardcoded in qft-runner.js but can be modified in the Config class
