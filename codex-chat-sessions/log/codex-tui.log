ort emit_prompt\n\n        mods[\"emit_prompt\"] = emit_prompt\n    except Exception as exc:\n        mods[\"emit_prompt_err\"] = exc\n\n    return mods\n\n\nMODS = _try_import()\n\n\nclass StepLimitReached(RuntimeError):\n    pass\n\n\nclass EpisodeLimitReached(RuntimeError):\n    pass\n\n\nclass RSSWatchdogTriggered(RuntimeError):\n    pass\n\n\n@dataclass\nclass SafetyLimits:\n    max_steps: int = 64\n    max_episodes: int = 1\n    rss_threshold: float = 0.85\n\n\nclass RunLock:\n    def __init__(self, path: str, run_id: str):\n        self.path = Path(path)\n        self.run_id = run_id\n        self._held = False\n\n    @staticmethod\n    def _pid_alive(pid: int) -> bool:\n        if pid <= 0:\n            return False\n        try:\n            os.kill(pid, 0)\n            return True\n        except Exception:\n            return False\n\n    def acquire(self) -> None:\n        if self.path.exists():\n            stale = True\n            try:\n                payload = json.loads(self.path.read_text(encoding=\"utf-8\"))\n                pid = int(payload.get(\"pid\", -1))\n                stale = not self._pid_alive(pid)\n            except Exception:\n                stale = False\n            if stale:\n                self.path.unlink(missing_ok=True)\n            else:\n                raise RuntimeError(f\"Lockfile already exists: {self.path}\")\n\n        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY\n        fd = os.open(str(self.path), flags)\n        try:\n            payload = {\n                \"run_id\": self.run_id,\n                \"pid\": os.getpid(),\n                \"created_unix\": time.time(),\n            }\n            os.write(fd, json.dumps(payload, ensure_ascii=True).encode(\"utf-8\"))\n        finally:\n            os.close(fd)\n        self._held = True\n\n    def release(self) -> None:\n        if self._held:\n            self.path.unlink(missing_ok=True)\n            self._held = False\n\n    def __enter__(self) -> \"RunLock\":\n        self.acquire()\n        return self\n\n    def __exit__(self, exc_type, exc, tb) -> None:\n        self.release()\n\n\ndef _total_ram_mb() -> Optional[float]:\n    if psutil is not None:\n        try:\n            return float(psutil.virtual_memory().total) / (1024.0 * 1024.0)\n        except Exception:\n            pass\n    if hasattr(os, \"sysconf\"):\n        try:\n            page_size = int(os.sysconf(\"SC_PAGE_SIZE\"))\n            pages = int(os.sysconf(\"SC_PHYS_PAGES\"))\n            return (page_size * pages) / (1024.0 * 1024.0)\n        except Exception:\n            return None\n    return None\n\n\ndef _process_rss_mb() -> Optional[float]:\n    if psutil is not None:\n        try:\n            return float(psutil.Process(os.getpid()).memory_info().rss) / (1024.0 * 1024.0)\n        except Exception:\n            pass\n    try:\n        import resource  # type: ignore\n\n        rss = float(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)\n        if sys.platform == \"darwin\":\n            return rss / (1024.0 * 1024.0)\n        return (rss * 1024.0) / (1024.0 * 1024.0)\n    except Exception:\n        return None\n\n\nclass RSSWatchdog:\n    def __init__(self, threshold: float):\n        self.threshold = threshold\n        self.total_mb = _total_ram_mb()\n\n    def sample(self) -> Tuple[Optional[float], Optional[float], Optional[float], bool]:\n        rss_mb = _process_rss_mb()\n        total_mb = self.total_mb\n        ratio = None\n        tripped = False\n        if rss_mb is not None and total_mb is not None and total_mb > 0:\n            ratio = rss_mb / total_mb\n            tripped = ratio >= self.threshold\n        return rss_mb, total_mb, ratio, tripped\n\n\nclass JsonlTelemetryWriter:\n    def __init__(self, path: str, flush_every: int = 1):\n        self.path = Path(path)\n        self.flush_every = max(1, int(flush_every))\n        self._fh = None\n        self._count = 0\n\n    def __enter__(self) -> \"JsonlTelemetryWriter\":\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        self._fh = self.path.open(\"a\", encoding=\"utf-8\", buffering=1)\n        return self\n\n    def write_record(self, record: Dict[str, Any]) -> None:\n        if self._fh is None:\n            raise RuntimeError(\"Telemetry writer is not open.\")\n        self._fh.write(json.dumps(record, ensure_ascii=False) + \"\\n\")\n        self._count += 1\n        if self._count % self.flush_every == 0:\n            self.flush()\n\n    def flush(self) -> None:\n        if self._fh is None:\n            return\n        self._fh.flush()\n        try:\n            os.fsync(self._fh.fileno())\n        except Exception:\n            pass\n\n    def close(self) -> None:\n        if self._fh is not None:\n            self.flush()\n            self._fh.close()\n            self._fh = None\n\n    def __exit__(self, exc_type, exc, tb) -> None:\n        self.close()\n\n\nclass CycleTracker:\n    def __init__(self, window: int = 256):\n        self.obs_hashes: deque[str] = deque(maxlen=window)\n        self.action_hashes: deque[str] = deque(maxlen=window)\n\n    def update(self, obs_hash: str, action_hash: str) -> Dict[str, bool]:\n        repeat_obs = obs_hash in self.obs_hashes\n        repeat_action = action_hash in self.action_hashes\n        short_cycle = len(self.action_hashes) >= 2 and self.action_hashes[-2] == action_hash\n\n        self.obs_hashes.append(obs_hash)\n        self.action_hashes.append(action_hash)\n        return {\n            \"repeat_obs\": repeat_obs,\n            \"repeat_action\": repeat_action,\n            \"short_cycle\": short_cycle,\n        }\n\n\n@contextlib.contextmanager\ndef inference_guard(models: Optional[List[Any]] = None):\n    state = {\n        \"inference_only\": True,\n        \"no_grad_applied\": False,\n        \"eval_applied\": False,\n    }\n    torch_mod = None\n    no_grad_ctx = None\n    prev_grad = None\n\n    try:\n        import torch  # type: ignore\n\n        torch_mod = torch\n        prev_grad = torch_mod.is_grad_enabled()\n        torch_mod.set_grad_enabled(False)\n        no_grad_ctx = torch_mod.no_grad()\n        no_grad_ctx.__enter__()\n        state[\"no_grad_applied\"] = True\n    except Exception:\n        torch_mod = None\n\n    if models:\n        for model in models:\n            if hasattr(model, \"eval\") and callable(getattr(model, \"eval\")):\n                try:\n                    model.eval()\n                    state[\"eval_applied\"] = True\n                except Exception:\n                    pass\n\n    try:\n        yield state\n    finally:\n        if no_grad_ctx is not None:\n            no_grad_ctx.__exit__(None, None, None)\n        if torch_mod is not None and prev_grad is not None:\n            torch_mod.set_grad_enabled(prev_grad)\n\n\ndef _json_hash(payload: Any) -> str:\n    blob = json.dumps(payload, sort_keys=True, ensure_ascii=True, separators=(\",\", \":\"), default=str)\n    return hashlib.sha256(blob.encode(\"utf-8\")).hexdigest()[:16]\n\n\ndef _entropy_and_gap(counts: Dict[str, int]) -> Tuple[Optional[float], Optional[float], Optional[float]]:\n    if not counts:\n        return None, None, None\n    arr = np.array(list(counts.values()), dtype=float)\n    total = float(arr.sum())\n    if total <= 0:\n        return 0.0, 0.0, 0.0\n    probs = arr / total\n    nz = probs[probs > 0]\n    entropy = float(-(nz * np.log2(nz)).sum())\n    max_entropy = float(math.log2(len(probs))) if len(probs) > 1 else 1.0\n    entropy_norm = entropy / max_entropy if max_entropy > 0 else 0.0\n    s = np.sort(probs)[::-1]\n    topk_gap = float(s[0] - s[1]) if len(s) > 1 else float(s[0])\n    return entropy, entropy_norm, topk_gap\n\n\nACTION_SYMBOLS = {\n    \"pca\": \"action.pca\",\n    \"prep\": \"action.prep\",\n    \"prerank\": \"action.prerank\",\n    \"qft\": \"action.qft\",\n    \"decode\": \"action.decode\",\n    \"emit\": \"action.emit\",\n}\n\nTOOL_SYMBOLS = {\n    \"qft_pca\": \"tool.qft_pca\",\n    \"layered_qft\": \"tool.layered_qft\",\n    \"prerank_wedge\": \"tool.prerank_wedge\",\n    \"decode_qft_hist\": \"tool.decode_qft_hist\",\n    \"emit_prompt\": \"tool.emit_prompt\",\n    \"fallback_decoder\": \"tool.fallback_decoder\",\n    \"subprocess_python\": \"tool.subprocess_python\",\n}\n\nTERMINATION_SYMBOLS = {\n    \"running\": \"term.chunk_ok\",\n    \"episode_done\": \"term.episode_done\",\n    \"run_done\": \"term.run_done\",\n    \"failure\": \"term.chunk_failed\",\n    \"chunk_skipped\": \"term.chunk_skipped\",\n    \"watchdog_exit\": \"term.watchdog_exit\",\n    \"max_steps_hit\": \"term.max_steps_hit\",\n    \"max_episodes_hit\": \"term.max_episodes_hit\",\n}\n\n\ndef derive_symbols(\n    action_type: str,\n    tool_name: str,\n    termination: str,\n    entropy_norm: Optional[float],\n    topk_gap: Optional[float],\n    constraint_pass: Optional[bool],\n    cycle_flags: Dict[str, bool],\n    inference_state: Dict[str, bool],\n    provenance_tag: bool,\n    lockfile_acquired: bool,\n    command_mode: str,\n    rss_ratio: Optional[float],\n    watchdog_tripped: bool,\n    seed: Optional[int],\n) -> List[str]:\n    symbols: List[str] = []\n    seen = set()\n\n    def add(name: str) -> None:\n        if name and name not in seen:\n            symbols.append(name)\n            seen.add(name)\n\n    add(\"meta.schema_v1\")\n    add(\"meta.chunk_boundary\")\n    if provenance_tag:\n        add(\"meta.provenance_tag_enabled\")\n    if seed is not None:\n        add(\"meta.seed_present\")\n\n    add(\"action.full_pipeline\" if command_mode == \"all\" else \"action.single_command\")\n    add(\"action.tool_boundary\")\n    add(ACTION_SYMBOLS.get(action_type, \"\"))\n    add(TOOL_SYMBOLS.get(tool_name, \"\"))\n    add(TERMINATION_SYMBOLS.get(termination, \"term.chunk_ok\"))\n\n    if constraint_pass is not None:\n        add(\"constraint.check_available\")\n        add(\"constraint.pass\" if constraint_pass else \"constraint.fail\")\n\n    if entropy_norm is not None:\n        add(\"uncert.entropy_available\")\n        add(\"uncert.entropy_high\" if entropy_norm >= 0.75 else \"uncert.entropy_low\")\n    if topk_gap is not None:\n        add(\"uncert.topk_gap_available\")\n        add(\"uncert.topk_gap_low\" if topk_gap < 0.08 else \"uncert.topk_gap_high\")\n\n    if cycle_flags.get(\"repeat_obs\"):\n        add(\"loop.repeat_obs_hash\")\n    if cycle_flags.get(\"repeat_action\"):\n        add(\"loop.repeat_action_hash\")\n    if cycle_flags.get(\"short_cycle\"):\n        add(\"loop.short_cycle\")\n\n    if inference_state.get(\"inference_only\", False):\n        add(\"mode.inference_only\")\n    if inference_state.get(\"no_grad_applied\", False):\n        add(\"mode.no_grad_applied\")\n    if inference_state.get(\"eval_applied\", False):\n        add(\"mode.eval_applied\")\n\n    if lockfile_acquired:\n        add(\"resource.lockfile_acquired\")\n    add(\"resource.flush_per_chunk\")\n    if rss_ratio is not None:\n        add(\"resource.rss_sampled\")\n        add(\"resource.rss_watchdog_tripped\" if watchdog_tripped else \"resource.rss_watchdog_ok\")\n\n    return symbols\n\n\nclass RunContext:\n    def __init__(\n        self,\n        run_id: str,\n        seed: Optional[int],\n        limits: SafetyLimits,\n        watchdog: RSSWatchdog,\n        writer: JsonlTelemetryWriter,\n        inference_state: Dict[str, bool],\n        provenance_tag: bool,\n        lockfile_acquired: bool,\n        command_mode: str,\n    ):\n        self.run_id = run_id\n        self.seed = seed\n        self.limits = limits\n        self.watchdog = watchdog\n        self.writer = writer\n        self.inference_state = inference_state\n        self.provenance_tag = provenance_tag\n        self.lockfile_acquired = lockfile_acquired\n        self.command_mode = command_mode\n\n        self.chunk_id = 0\n        self.steps_by_episode: Dict[int, int] = {}\n        self.episodes_seen: Dict[int, bool] = {}\n        self.cycles = CycleTracker(window=256)\n\n    def _register_episode(self, episode_id: int) -> None:\n        if episode_id not in self.episodes_seen:\n            if len(self.episodes_seen) >= self.limits.max_episodes:\n                raise EpisodeLimitReached(\n                    f\"max_episodes reached ({self.limits.max_episodes}); cannot add episode_id={episode_id}\"\n                )\n            self.episodes_seen[episode_id] = True\n\n    def emit_chunk(\n        self,\n        episode_id: int,\n        action_type: str,\n        tool_name: str,\n        observation: Dict[str, Any],\n        action: Dict[str, Any],\n        termination: str = \"running\",\n        constraint_pass: Optional[bool] = True,\n        entropy: Optional[float] = None,\n        entropy_norm: Optional[float] = None,\n        topk_gap: Optional[float] = None,\n        extra_scalars: Optional[Dict[str, float]] = None,\n        count_step: bool = True,\n        check_watchdog: bool = True,\n    ) -> Dict[str, Any]:\n        self._register_episode(episode_id)\n\n        if count_step:\n            used = self.steps_by_episode.get(episode_id, 0)\n            if used >= self.limits.max_steps:\n                raise StepLimitReached(\n                    f\"max_steps reached ({self.limits.max_steps}) for episode_id={episode_id}\"\n                )\n            self.steps_by_episode[episode_id] = used + 1\n\n        self.chunk_id += 1\n\n        obs_hash = _json_hash(observation)\n        action_hash = _json_hash(action)\n        cycle_flags = self.cycles.update(obs_hash, action_hash)\n\n        rss_mb, total_mb, rss_ratio, tripped = self.watchdog.sample()\n        if not check_watchdog:\n            tripped = False\n\n        effective_termination = \"watchdog_exit\" if tripped else termination\n        symbols = derive_symbols(\n            action_type=action_type,\n            tool_name=tool_name,\n            termination=effective_termination,\n            entropy_norm=entropy_norm,\n            topk_gap=topk_gap,\n            constraint_pass=constraint_pass,\n            cycle_flags=cycle_flags,\n            inference_state=self.inference_state,\n            provenance_tag=self.provenance_tag,\n            lockfile_acquired=self.lockfile_acquired,\n            command_mode=self.command_mode,\n            rss_ratio=rss_ratio,\n            watchdog_tripped=tripped,\n            seed=self.seed,\n        )\n\n        bitset = sc1028_encode(symbols, strict=True)\n        sc1028_b64 = sc1028_to_base64url(bitset)\n\n        scalars: Dict[str, float] = {\n            \"constraint_pass\": float(1.0 if constraint_pass else 0.0) if constraint_pass is not None else -1.0,\n            \"repeat_obs\": float(1.0 if cycle_flags[\"repeat_obs\"] else 0.0),\n            \"repeat_action\": float(1.0 if cycle_flags[\"repeat_action\"] else 0.0),\n            \"short_cycle\": float(1.0 if cycle_flags[\"short_cycle\"] else 0.0),\n        }\n        if rss_mb is not None:\n            scalars[\"rss_mb\"] = float(rss_mb)\n        if total_mb is not None:\n            scalars[\"total_ram_mb\"] = float(total_mb)\n        if rss_ratio is not None:\n            scalars[\"rss_ratio\"] = float(rss_ratio)\n        if entropy is not None:\n            scalars[\"entropy\"] = float(entropy)\n        if entropy_norm is not None:\n            scalars[\"entropy_norm\"] = float(entropy_norm)\n        if topk_gap is not None:\n            scalars[\"topk_gap\"] = float(topk_gap)\n        if extra_scalars:\n            for key, value in extra_scalars.items():\n                try:\n                    scalars[key] = float(value)\n                except Exception:\n                    pass\n\n        record = {\n            \"run_id\": self.run_id,\n            \"episode_id\": episode_id,\n            \"chunk_id\": self.chunk_id,\n            \"obs_hash\": obs_hash,\n            \"action_hash\": action_hash,\n            \"sc1028_b64\": sc1028_b64,\n            \"sc1028_symbols\": symbols,\n            \"sc1028_version\": SC1028_VERSION,\n            \"scalars\": scalars,\n            \"termination\": effective_termination,\n            \"seed\": self.seed,\n            \"ts_unix\": time.time(),\n        }\n        self.writer.write_record(record)\n\n        if tripped:\n            raise RSSWatchdogTriggered(\n                f\"RSS watchdog triggered: rss_ratio={rss_ratio:.4f} threshold={self.limits.rss_threshold:.4f}\"\n            )\n\n        return record\n\n\n# ---------- IO helpers ----------\n\ndef load_vectors(src: str) -> Tuple[np.ndarray, Optional[List[dict]]]:\n    p = Path(src)\n    if not p.exists():\n        raise FileNotFoundError(f\"Source not found: {src}\")\n\n    if p.suffix.lower() == \".npy\":\n        return np.load(str(p)), None\n\n    if p.suffix.lower() == \".jsonl\":\n        rows: List[dict] = []\n        with p.open(\"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                rows.append(json.loads(line))\n        if not rows or \"vector\" not in rows[0]:\n            raise ValueError(\"JSONL rows must include a 'vector' field.\")\n        X = np.array([r[\"vector\"] for r in rows], dtype=float)\n        return X, rows\n\n    raise ValueError(\"Unsupported source format. Use .npy or .jsonl\")\n\n\n# ---------- Stage 1: PCA ----------\n\ndef run_pca(src: str, target_dim: int, out_prefix: str, force: bool = False) -> Tuple[str, Dict[str, float]]:\n    out_mu = f\"{out_prefix}_mu.npy\"\n    out_w = f\"{out_prefix}_W.npy\"\n    out_z = f\"{out_prefix}_Z.npy\"\n\n    if (not force) and Path(out_z).exists() and Path(out_mu).exists() and Path(out_w).exists():\n        print(f\"[pca] Re-using existing {out_z}\")\n        shape = np.load(out_z, mmap_mode=\"r\").shape\n        return out_z, {\n            \"reused\": 1.0,\n            \"rows\": float(shape[0]),\n            \"dim\": float(shape[1]),\n        }\n\n    X, _ = load_vectors(src)\n    print(f\"[pca] Loaded {X.shape} from {src}\")\n\n    if \"qft_pca\" not in MODS:\n        raise RuntimeError(\"qft_pca.py not available; cannot run PCA.\")\n\n    mu, W = MODS[\"qft_pca\"].fit_pca(X, target_dim)\n    Z = MODS[\"qft_pca\"].project_normalize(X, mu, W)\n\n    np.save(out_mu, mu)\n    np.save(out_w, W)\n    np.save(out_z, Z)\n    print(f\"[pca] Wrote {out_z} (and {out_mu}, {out_w})\")\n\n    return out_z, {\n        \"reused\": 0.0,\n        \"rows\": float(Z.shape[0]),\n        \"dim\": float(Z.shape[1]),\n    }\n\n\n# ---------- Stage 2: prep ----------\n\ndef sparsify_pad(Z: np.ndarray, sparsity: float) -> np.ndarray:\n    if not (0.0 < sparsity < 1.0):\n        raise ValueError(\"--sparsity must be in (0,1)\")\n\n    Z2 = Z.copy()\n    N, D = Z2.shape\n    k = int(round((1.0 - sparsity) * D))\n    k = max(1, min(k, D))\n\n    idxs = np.argpartition(np.abs(Z2), -k, axis=1)[:, :-k]\n    Z2[np.arange(N)[:, None], idxs] = 0.0\n\n    norms = np.linalg.norm(Z2, axis=1, keepdims=True) + 1e-12\n    return Z2 / norms\n\n\ndef pad_pow2(X: np.ndarray) -> np.ndarray:\n    N, D = X.shape\n    n = int(math.ceil(math.log2(max(1, D))))\n    size = 1 << n\n    if size == D:\n        return X\n    padded = np.zeros((N, size), dtype=X.dtype)\n    padded[:, :D] = X\n    return padded\n\n\ndef run_prep(pca_z_path: str, sparsity: float, out_path: str, force: bool = False) -> Tuple[str, Dict[str, float]]:\n    if (not force) and Path(out_path).exists():\n        print(f\"[prep] Re-using existing {out_path}\")\n        shape = np.load(out_path, mmap_mode=\"r\").shape\n        nnz = float(np.count_nonzero(np.load(out_path, mmap_mode=\"r\")))\n        return out_path, {\n            \"reused\": 1.0,\n            \"rows\": float(shape[0]),\n            \"dim\": float(shape[1]),\n            \"density\": nnz / float(shape[0] * shape[1]),\n        }\n\n    Z = np.load(pca_z_path)\n    print(f\"[prep] Loaded PCA-projected matrix: {Z.shape}\")\n    Zs = sparsify_pad(Z, sparsity=sparsity)\n    Zp = pad_pow2(Zs)\n    np.save(out_path, Zp)\n    print(f\"[prep] Wrote {out_path} (shape={Zp.shape}, qubits={int(math.log2(Zp.shape[1]))})\")\n\n    return out_path, {\n        \"reused\": 0.0,\n        \"rows\": float(Zp.shape[0]),\n        \"dim\": float(Zp.shape[1]),\n        \"density\": float(np.count_nonzero(Zp)) / float(Zp.size),\n    }\n\n\n# ---------- Stage 3: prerank ----------\n\ndef run_prerank(\n    prepped_path: str,\n    theme_id: int,\n    bands: int = 64,\n    gate: float = 0.35,\n    sample: int = 0,\n) -> Tuple[List[int], Dict[str, float]]:\n    if \"prerank_wedge\" not in MODS:\n        print(\"[prerank] prerank_wedge.py not available; skipping.\")\n        return [], {\"available\": 0.0}\n\n    X = np.load(prepped_path)\n    pr = MODS[\"prerank_wedge\"].PreRanker(d=X.shape[1], bands=bands, mixer_layers=2, gate=gate)\n    cache = [pr.build_cache_entry(x, theme_id=theme_id, pos=i) for i, x in enumerate(X)]\n    scored = sorted([(i, float(c[\"weight\"])) for i, c in enumerate(cache)], key=lambda t: -t[1])\n\n    order = [i for i, _ in scored]\n    if sample > 0:\n        order = order[:sample]\n\n    top_weight = float(scored[0][1]) if scored else 0.0\n    second_weight = float(scored[1][1]) if len(scored) > 1 else 0.0\n    print(f\"[prerank] Selected {len(order)} rows (theme_id={theme_id})\")\n\n    return order, {\n        \"available\": 1.0,\n        \"selected\": float(len(order)),\n        \"top_weight\": top_weight,\n        \"top_weight_gap\": top_weight - second_weight,\n    }\n\n\n# ---------- Stage 4: QFT ----------\n\ndef run_qft(\n    prepped_path: str,\n    row: int,\n    nqubits: Optional[int],\n    backend: str,\n    shots: int,\n    layered: bool = False,\n    theme_id: int = 0,\n    pos: int = 0,\n    optimization_level: int = 1,\n) -> Tuple[str, Dict[str, float]]:\n    vecs = np.load(prepped_path)\n    if row < 0 or row >= vecs.shape[0]:\n        raise IndexError(f\"row {row} out of range 0..{vecs.shape[0] - 1}\")\n\n    v = vecs[row]\n    if nqubits is None:\n        nqubits = int(math.ceil(math.log2(len(v))))\n\n    if layered:\n        if \"layered_qft\" not in MODS:\n            raise RuntimeError(\"layered_qft.py not available for --layered run.\")\n        from qiskit_ibm_runtime import QiskitRuntimeService, SamplerV2 as Sampler\n\n        service = QiskitRuntimeService(\n            channel=\"ibm_cloud\",\n            token=os.environ.get(\"IBM_CLOUD_API_KEY\"),\n            instance=os.environ.get(\"IBM_QUANTUM_CRN\"),\n        )\n        bk = service.backend(backend)\n        qc = MODS[\"layered_qft\"].build_interference_circuit(v, n_qubits=nqubits, theme_id=theme_id, pos=pos, backend=bk)\n        sampler = Sampler(bk)\n        job = sampler.run([qc], shots=shots)\n        result = job.result()\n        record = result[0]\n        qd = record.data\n        counts = {str(k): int(float(val) * shots) for k, val in qd.items()}\n        tool_name = \"layered_qft\"\n    else:\n        if \"qft_pca\" not in MODS:\n            raise RuntimeError(\"qft_pca.py not available for basic QFT run.\")\n        counts = MODS[\"qft_pca\"].fourier_fingerprint_runtime(\n            amplitudes=v,\n            shots=shots,\n            backend_name=backend,\n            optimization_level=optimization_level,\n        )\n        tool_name = \"qft_pca\"\n\n    out_path = f\"job_qft_counts_row{row}_{backend}_{shots}.json\"\n    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(counts, f, indent=2)\n    print(f\"[qft] Saved counts -> {out_path}\")\n\n    entropy, entropy_norm, topk_gap = _entropy_and_gap(counts)\n    return out_path, {\n        \"row\": float(row),\n        \"tool_layered\": 1.0 if layered else 0.0,\n        \"bins\": float(len(counts)),\n        \"entropy\": float(entropy if entropy is not None else -1.0),\n        \"entropy_norm\": float(entropy_norm if entropy_norm is not None else -1.0),\n        \"topk_gap\": float(topk_gap if topk_gap is not None else -1.0),\n        \"tool_name\": 1.0 if tool_name == \"layered_qft\" else 0.0,\n    }\n\n\n# ---------- Stage 5: decode ----------\n\ndef run_decode(counts_path: str, rope_path: Optional[str], vectors_jsonl: Optional[str], out_path: str) -> Tuple[str, Dict[str, float], str]:\n    if \"decode_qft_hist\" in MODS:\n        os.environ[\"QFT_COUNTS\"] = counts_path\n        if rope_path:\n            os.environ[\"QFT_ROPE\"] = rope_path\n        if vectors_jsonl:\n            os.environ[\"QFT_VECTORS\"] = vectors_jsonl\n        os.environ[\"QFT_OUT\"] = out_path\n\n        if hasattr(MODS[\"decode_qft_hist\"], \"main\"):\n            MODS[\"decode_qft_hist\"].main()\n        else:\n            import importlib\n\n            importlib.reload(MODS[\"decode_qft_hist\"])\n\n        print(f\"[decode] Wrote {out_path}\")\n        return out_path, {\"fallback\": 0.0}, \"decode_qft_hist\"\n\n    with open(counts_path, \"r\", encoding=\"utf-8\") as f:\n        counts = json.load(f)\n    total = sum(counts.values()) or 1\n    probs = {k: v / total for k, v in counts.items()}\n    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump({\"probs\": probs, \"note\": \"fallback decoder (install decode_qft_hist.py)\"}, f, indent=2)\n    print(f\"[decode] Fallback wrote {out_path}\")\n    return out_path, {\"fallback\": 1.0}, \"fallback_decoder\"\n\n\n# ---------- Stage 6: emit ----------\n\ndef run_emit(\n    rope_path: str,\n    background_json: str,\n    payload_out: str,\n    counts_top: int = 32,\n    basis_top: int = 24,\n    clusters: int = 16,\n) -> Dict[str, float]:\n    if \"emit_prompt\" not in MODS:\n        raise RuntimeError(\"emit_prompt.py not available for --emit stage.\")\n\n    cmd = (\n        f'python -m emit_prompt --rope \"{rope_path}\" --background \"{background_json}\" '\n        f'--emit-payload \"{payload_out}\" --counts-top {counts_top} --basis-top {basis_top} --clusters {clusters}'\n    )\n    print(\"[emit] Running:\", cmd)\n    rc = os.system(cmd)\n    if rc != 0:\n        raise RuntimeError(f\"emit_prompt failed with exit code {rc}\")\n    print(f\"[emit] Wrote {payload_out}\")\n    return {\"emit_rc\": float(rc)}\n\n\ndef _add_runtime_options(a: argparse.ArgumentParser) -> None:\n    a.add_argument(\"--telemetry-out\", type=str, default=\"sc1028_telemetry.jsonl\", help=\"JSONL sidecar telemetry path.\")\n    a.add_argument(\"--lockfile\", type=str, default=\"run.lock\", help=\"Single-instance lockfile path.\")\n    a.add_argument(\"--max-steps\", type=int, default=64, help=\"Max chunk steps per episode.\")\n    a.add_argument(\"--max-episodes\", type=int, default=1, help=\"Max episodes per run.\")\n    a.add_argument(\"--rss-threshold\", type=float, default=0.85, help=\"RSS/Total RAM ratio threshold.\")\n    a.add_argument(\"--seed\", type=int, default=None, help=\"Optional seed for run metadata.\")\n    a.add_argument(\"--provenance-tag\", action=\"store_true\", help=\"Emit explicit provenance block at the end.\")\n\n\ndef _payload_for_episode(base_path: str, episode_id: int, multi_episode: bool) -> str:\n    if not multi_episode:\n        return base_path\n    p = Path(base_path)\n    if p.suffix:\n        return str(p.with_name(f\"{p.stem}_ep{episode_id}{p.suffix}\"))\n    return str(p.with_name(f\"{p.name}_ep{episode_id}\"))\n\n\n# ---------- CLI ----------\n\ndef main() -> None:\n    ap = argparse.ArgumentParser(description=\"Single-file QFT pipeline orchestration with SC1028 telemetry.\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    def add_common_io(a: argparse.ArgumentParser) -> None:\n        a.add_argument(\"--src\", type=str, help=\"Vectors source: .npy or .jsonl with 'vector' fields.\")\n        a.add_argument(\"--prepped\", type=str, help=\"Prepped .npy (sparse, pow2) if skipping PCA/prep.\")\n        a.add_argument(\"--out-prefix\", type=str, default=\"qft\", help=\"Output prefix for PCA artifacts.\")\n        a.add_argument(\"--force\", action=\"store_true\", help=\"Recompute even if outputs exist.\")\n\n    p_pca = sub.add_parser(\"pca\", help=\"Fit PCA and project.\")\n    add_common_io(p_pca)\n    p_pca.add_argument(\"--target-dim\", type=int, required=True, help=\"Dimension after PCA.\")\n    _add_runtime_options(p_pca)\n\n    p_prep = sub.add_parser(\"prep\", help=\"Sparsify and pad to pow2.\")\n    p_prep.add_argument(\"--pca-Z\", type=str, required=True, help=\"Input PCA-projected matrix (.npy).\")\n    p_prep.add_argument(\"--sparsity\", type=float, required=True, help=\"Fraction of zeros per row.\")\n    p_prep.add_argument(\"--out\", type=str, default=\"vectors_pca_topk.npy\", help=\"Output prepped .npy\")\n    p_prep.add_argument(\"--force\", action=\"store_true\")\n    _add_runtime_options(p_prep)\n\n    p_rank = sub.add_parser(\"prerank\", help=\"Theme-gated preselection.\")\n    p_rank.add_argument(\"--prepped\", type=str, required=True, help=\"Prepped .npy\")\n    p_rank.add_argument(\"--theme-id\", type=int, required=True)\n    p_rank.add_argument(\"--bands\", type=int, default=64)\n    p_rank.add_argument(\"--gate\", type=float, default=0.35)\n    p_rank.add_argument(\"--sample\", type=int, default=0, help=\"Return only top N indexes (0=all)\")\n    _add_runtime_options(p_rank)\n\n    p_qft = sub.add_parser(\"qft\", help=\"Run QFT on IBM.\")\n    p_qft.add_argument(\"--prepped\", type=str, required=True, help=\"Prepped .npy\")\n    p_qft.add_argument(\"--row\", type=int, default=0)\n    p_qft.add_argument(\"--nqubits\", type=int, default=None)\n    p_qft.add_argument(\"--backend\", type=str, default=\"ibm_brisbane\")\n    p_qft.add_argument(\"--shots\", type=int, default=4096)\n    p_qft.add_argument(\"--layered\", action=\"store_true\", help=\"Use layered_qft interference circuit.\")\n    p_qft.add_argument(\"--theme-id\", type=int, default=0)\n    p_qft.add_argument(\"--pos\", type=int, default=0)\n    p_qft.add_argument(\"--optimization-level\", type=int, default=1)\n    _add_runtime_options(p_qft)\n\n    p_dec = sub.add_parser(\"decode\", help=\"Decode counts to spectrum/NN.\")\n    p_dec.add_argument(\"--counts\", type=str, required=True)\n    p_dec.add_argument(\"--rope\", type=str, default=None)\n    p_dec.add_argument(\"--vectors-jsonl\", type=str, default=None)\n    p_dec.add_argument(\"--out\", type=str, default=\"decoded_evidence.json\")\n    _add_runtime_options(p_dec)\n\n    p_emit = sub.add_parser(\"emit\", help=\"Emit compact system/payload using emit_prompt.py\")\n    p_emit.add_argument(\"--rope\", type=str, required=True)\n    p_emit.add_argument(\"--background\", type=str, required=True, help=\"evidence.json or decoded JSON\")\n    p_emit.add_argument(\"--payload-out\", type=str, default=\"request_skeleton.json\")\n    p_emit.add_argument(\"--counts-top\", type=int, default=32)\n    p_emit.add_argument(\"--basis-top\", type=int, default=24)\n    p_emit.add_argument(\"--clusters\", type=int, default=16)\n    _add_runtime_options(p_emit)\n\n    p_all = sub.add_parser(\"all\", help=\"Run pca->prep->(prerank)->qft->decode->emit in sequence.\")\n    add_common_io(p_all)\n    p_all.add_argument(\"--target-dim\", type=int, required=True)\n    p_all.add_argument(\"--sparsity\", type=float, required=True)\n    p_all.add_argument(\"--row\", type=int, default=0)\n    p_all.add_argument(\"--nqubits\", type=int, default=None)\n    p_all.add_argument(\"--backend\", type=str, default=\"ibm_brisbane\")\n    p_all.add_argument(\"--shots\", type=int, default=4096)\n    p_all.add_argument(\"--layered\", action=\"store_true\")\n    p_all.add_argument(\"--theme-id\", type=int, default=None, help=\"If set, run prerank and pick row(s) by rank.\")\n    p_all.add_argument(\"--pos\", type=int, default=0)\n    p_all.add_argument(\"--optimization-level\", type=int, default=1)\n    p_all.add_argument(\"--rope\", type=str, default=None)\n    p_all.add_argument(\"--vectors-jsonl\", type=str, default=None)\n    p_all.add_argument(\"--payload-out\", type=str, default=\"request_skeleton.json\")\n    _add_runtime_options(p_all)\n\n    args = ap.parse_args()\n\n    if args.max_steps <= 0:\n        ap.error(\"--max-steps must be > 0\")\n    if args.max_episodes <= 0:\n        ap.error(\"--max-episodes must be > 0\")\n    if not (0.80 <= args.rss_threshold <= 0.95):\n        ap.error(\"--rss-threshold must be between 0.80 and 0.95\")\n\n    if args.seed is not None:\n        np.random.seed(args.seed)\n\n    run_id = uuid.uuid4().hex\n    limits = SafetyLimits(max_steps=args.max_steps, max_episodes=args.max_episodes, rss_threshold=args.rss_threshold)\n\n    ctx: Optional[RunContext] = None\n\n    try:\n        with RunLock(args.lockfile, run_id) as lock:\n            with JsonlTelemetryWriter(args.telemetry_out, flush_every=1) as writer:\n                watchdog = RSSWatchdog(args.rss_threshold)\n                with inference_guard(models=None) as inference_state:\n                    ctx = RunContext(\n                        run_id=run_id,\n                        seed=args.seed,\n                        limits=limits,\n                        watchdog=watchdog,\n                        writer=writer,\n                        inference_state=inference_state,\n                        provenance_tag=bool(args.provenance_tag),\n                        lockfile_acquired=lock._held,\n                        command_mode=args.cmd,\n                    )\n\n                    if args.cmd == \"pca\":\n                        if not args.src:\n                            ap.error(\"pca requires --src\")\n                        out_z, info = run_pca(args.src, args.target_dim, args.out_prefix, force=args.force)\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"pca\",\n                            tool_name=\"qft_pca\",\n                            observation={\"src\": args.src},\n                            action={\"out\": out_z, \"target_dim\": args.target_dim},\n                            termination=\"episode_done\",\n                            constraint_pass=True,\n                            extra_scalars=info,\n                        )\n\n                    elif args.cmd == \"prep\":\n                        out, info = run_prep(args.pca_Z, args.sparsity, args.out, force=args.force)\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"prep\",\n                            tool_name=\"qft_pca\",\n                            observation={\"pca_Z\": args.pca_Z, \"sparsity\": args.sparsity},\n                            action={\"out\": out},\n                            termination=\"episode_done\",\n                            constraint_pass=True,\n                            extra_scalars=info,\n                        )\n\n                    elif args.cmd == \"prerank\":\n                        order, info = run_prerank(args.prepped, args.theme_id, bands=args.bands, gate=args.gate, sample=args.sample)\n                        print(json.dumps({\"order\": order}))\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"prerank\",\n                            tool_name=\"prerank_wedge\",\n                            observation={\"prepped\": args.prepped, \"theme_id\": args.theme_id},\n                            action={\"selected\": len(order), \"sample\": args.sample},\n                            termination=\"episode_done\",\n                            constraint_pass=bool(order or info.get(\"available\", 0.0) == 0.0),\n                            extra_scalars=info,\n                        )\n\n                    elif args.cmd == \"qft\":\n                        counts_path, qft_info = run_qft(\n                            args.prepped,\n                            args.row,\n                            args.nqubits,\n                            args.backend,\n                            args.shots,\n                            layered=args.layered,\n                            theme_id=args.theme_id,\n                            pos=args.pos,\n                            optimization_level=args.optimization_level,\n                        )\n                        entropy = qft_info.get(\"entropy\")\n                        entropy_norm = qft_info.get(\"entropy_norm\")\n                        topk_gap = qft_info.get(\"topk_gap\")\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"qft\",\n                            tool_name=\"layered_qft\" if args.layered else \"qft_pca\",\n                            observation={\"prepped\": args.prepped, \"row\": args.row},\n                            action={\"counts_path\": counts_path, \"backend\": args.backend, \"shots\": args.shots},\n                            termination=\"episode_done\",\n                            constraint_pass=True,\n                            entropy=entropy if entropy is not None and entropy >= 0 else None,\n                            entropy_norm=entropy_norm if entropy_norm is not None and entropy_norm >= 0 else None,\n                            topk_gap=topk_gap if topk_gap is not None and topk_gap >= 0 else None,\n                            extra_scalars=qft_info,\n                        )\n\n                    elif args.cmd == \"decode\":\n                        out, decode_info, tool_name = run_decode(args.counts, args.rope, args.vectors_jsonl, args.out)\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"decode\",\n                            tool_name=tool_name,\n                            observation={\"counts\": args.counts},\n                            action={\"out\": out, \"rope\": bool(args.rope), \"vectors_jsonl\": bool(args.vectors_jsonl)},\n                            termination=\"episode_done\",\n                            constraint_pass=True,\n                            extra_scalars=decode_info,\n                        )\n\n                    elif args.cmd == \"emit\":\n                        emit_info = run_emit(args.rope, args.background, args.payload_out, args.counts_top, args.basis_top, args.clusters)\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"emit\",\n                            tool_name=\"emit_prompt\",\n                            observation={\"rope\": args.rope, \"background\": args.background},\n                            action={\"payload_out\": args.payload_out},\n                            termination=\"episode_done\",\n                            constraint_pass=True,\n                            extra_scalars=emit_info,\n                        )\n\n                    elif args.cmd == \"all\":\n                        if not args.src and not args.prepped:\n                            ap.error(\"all requires either --src (.npy/.jsonl) or --prepped (.npy)\")\n\n                        if args.src:\n                            z_path, pca_info = run_pca(args.src, args.target_dim, args.out_prefix, force=args.force)\n                            ctx.emit_chunk(\n                                episode_id=0,\n                                action_type=\"pca\",\n                                tool_name=\"qft_pca\",\n                                observation={\"src\": args.src},\n                                action={\"out\": z_path, \"target_dim\": args.target_dim},\n                                constraint_pass=True,\n                                extra_scalars=pca_info,\n                            )\n                        else:\n                            z_path = args.prepped\n                            ctx.emit_chunk(\n                                episode_id=0,\n                                action_type=\"pca\",\n                                tool_name=\"qft_pca\",\n                                observation={\"prepped\": args.prepped},\n                                action={\"skip_pca\": True},\n                                termination=\"chunk_skipped\",\n                                constraint_pass=True,\n                            )\n\n                        prepped_path, prep_info = run_prep(z_path, args.sparsity, \"vectors_pca_topk.npy\", force=args.force)\n                        ctx.emit_chunk(\n                            episode_id=0,\n                            action_type=\"prep\",\n                            tool_name=\"qft_pca\",\n                            observation={\"pca_Z\": z_path, \"sparsity\": args.sparsity},\n                            action={\"out\": prepped_path},\n                            constraint_pass=True,\n                            extra_scalars=prep_info,\n                        )\n\n                        rows: List[int] = [args.row]\n                        if args.theme_id is not None:\n                            ordered_rows, rank_info = run_prerank(prepped_path, args.theme_id, sample=max(1, args.max_episodes))\n                            if ordered_rows:\n                                rows = ordered_rows\n                            ctx.emit_chunk(\n                                episode_id=0,\n                                action_type=\"prerank\",\n                                tool_name=\"prerank_wedge\",\n                                observation={\"prepped\": prepped_path, \"theme_id\": args.theme_id},\n                                action={\"candidate_rows\": len(rows)},\n                                constraint_pass=True,\n                                extra_scalars=rank_info,\n                            )\n\n                        if len(rows) > args.max_episodes:\n                            ctx.emit_chunk(\n                                episode_id=0,\n                                action_type=\"prerank\",\n                                tool_name=\"prerank_wedge\",\n                                observation={\"candidate_rows\": len(rows)},\n                                action={\"max_episodes\": args.max_episodes},\n                                termination=\"max_episodes_hit\",\n                                constraint_pass=False,\n                                count_step=False,\n                                check_watchdog=False,\n                            )\n\n                        rows = rows[: args.max_episodes]\n                        if not rows:\n                            rows = [args.row]\n\n                        multi_episode = len(rows) > 1\n\n                        for episode_id, row in enumerate(rows):\n                            counts_path, qft_info = run_qft(\n                                prepped_path,\n                                row,\n                                args.nqubits,\n                                args.backend,\n                                args.shots,\n                                layered=args.layered,\n                                theme_id=(args.theme_id or 0),\n                                pos=args.pos,\n                                optimization_level=args.optimization_level,\n                            )\n                            entropy = qft_info.get(\"entropy\")\n                            entropy_norm = qft_info.get(\"entropy_norm\")\n                            topk_gap = qft_info.get(\"topk_gap\")\n                            ctx.emit_chunk(\n                                episode_id=episode_id,\n                                action_type=\"qft\",\n                                tool_name=\"layered_qft\" if args.layered else \"qft_pca\",\n                                observation={\"row\": row, \"prepped\": prepped_path},\n                                action={\"counts_path\": counts_path},\n                                constraint_pass=True,\n                                entropy=entropy if entropy is not None and entropy >= 0 else None,\n                                entropy_norm=entropy_norm if entropy_norm is not None and entropy_norm >= 0 else None,\n                                topk_gap=topk_gap if topk_gap is not None and topk_gap >= 0 else None,\n                                extra_scalars=qft_info,\n                            )\n\n                            decoded_path = _payload_for_episode(\"decoded_evidence.json\", episode_id, multi_episode)\n                            if args.rope or args.vectors_jsonl:\n                                decoded_path, decode_info, decode_tool = run_decode(\n                                    counts_path,\n                                    args.rope,\n                                    args.vectors_jsonl,\n                                    decoded_path,\n                                )\n                                ctx.emit_chunk(\n                                    episode_id=episode_id,\n                                    action_type=\"decode\",\n                                    tool_name=decode_tool,\n                                    observation={\"counts\": counts_path},\n                                    action={\"out\": decoded_path},\n                                    constraint_pass=True,\n                                    extra_scalars=decode_info,\n                                )\n                            else:\n                                ctx.emit_chunk(\n                                    episode_id=episode_id,\n                                    action_type=\"decode\",\n                                    tool_name=\"decode_qft_hist\",\n                                    observation={\"counts\": counts_path},\n                                    action={\"skip_decode\": True},\n                                    termination=\"chunk_skipped\",\n                                    constraint_pass=True,\n                                )\n\n                            payload_path = _payload_for_episode(args.payload_out, episode_id, multi_episode)\n                            if args.rope and Path(decoded_path).exists():\n                                emit_info = run_emit(args.rope, decoded_path, payload_path)\n                                ctx.emit_chunk(\n                                    episode_id=episode_id,\n                                    action_type=\"emit\",\n                                    tool_name=\"emit_prompt\",\n                                    observation={\"decoded\": decoded_path, \"rope\": args.rope},\n                                    action={\"payload_out\": payload_path},\n                                    constraint_pass=True,\n                                    extra_scalars=emit_info,\n                                )\n                            else:\n                                ctx.emit_chunk(\n                                    episode_id=episode_id,\n                                    action_type=\"emit\",\n                                    tool_name=\"emit_prompt\",\n                                    observation={\"decoded\": decoded_path, \"rope\": args.rope},\n                                    action={\"skip_emit\": True},\n                                    termination=\"chunk_skipped\",\n                                    constraint_pass=True,\n                                )\n\n                            ctx.emit_chunk(\n                                episode_id=episode_id,\n                                action_type=\"qft\",\n                                tool_name=\"qft_pca\",\n                                observation={\"row\": row},\n                                action={\"episode_complete\": True},\n                                termination=\"episode_done\",\n                                constraint_pass=True,\n                                count_step=False,\n                                check_watchdog=False,\n                            )\n\n                        print(\"[all] DONE.\")\n\n                    ctx.emit_chunk(\n                        episode_id=0,\n                        action_type=\"qft\",\n                        tool_name=\"qft_pca\",\n                        observation={\"command\": args.cmd},\n                        action={\"run_complete\": True},\n                        termination=\"run_done\",\n                        constraint_pass=True,\n                        count_step=False,\n                        check_watchdog=False,\n                    )\n\n                    if args.provenance_tag:\n                        print(f\"PROVENANCE: run_id={run_id} sc1028_sidecar={args.telemetry_out}\")\n\n    except StepLimitReached as exc:\n        if ctx is not None:\n            ctx.emit_chunk(\n                episode_id=0,\n                action_type=\"qft\",\n                tool_name=\"qft_pca\",\n                observation={\"error\": str(exc)},\n                action={\"guardrail\": \"max_steps\"},\n                termination=\"max_steps_hit\",\n                constraint_pass=False,\n                count_step=False,\n                check_watchdog=False,\n            )\n        print(f\"[guardrail] {exc}\")\n        sys.exit(2)\n\n    except EpisodeLimitReached as exc:\n        if ctx is not None:\n            ctx.emit_chunk(\n                episode_id=0,\n                action_type=\"qft\",\n                tool_name=\"qft_pca\",\n                observation={\"error\": str(exc)},\n                action={\"guardrail\": \"max_episodes\"},\n                termination=\"max_episodes_hit\",\n                constraint_pass=False,\n                count_step=False,\n                check_watchdog=False,\n            )\n        print(f\"[guardrail] {exc}\")\n        sys.exit(2)\n\n    except RSSWatchdogTriggered as exc:\n        print(f\"[guardrail] {exc}\")\n        sys.exit(2)\n\n    except Exception as exc:\n        if ctx is not None:\n            ctx.emit_chunk(\n                episode_id=0,\n                action_type=\"qft\",\n                tool_name=\"qft_pca\",\n                observation={\"error\": str(exc)},\n                action={\"guardrail\": \"failure\"},\n                termination=\"failure\",\n                constraint_pass=False,\n                count_step=False,\n                check_watchdog=False,\n            )\n        print(f\"[error] {exc}\")\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n'@ | Set-Content -Encoding utf8 qft_one.py","workdir":"C:\\projects\\QuantumBlot\\qctx"} thread_id=019c49b5-b5aa-7bd1-b8d5-b3042fc08ca5
