+      console.log(`\nRunning: python3 ${script} ${args.join(' ')}`);
+      const proc = spawn('python3', [pythonPath, ...args], {
+        stdio: ['inherit', 'pipe', 'pipe'],
+        env: {
+          ...process.env,
+          QFT_RUNNER_INFERENCE_ONLY: '1',
+          QFT_RUNNER_NO_GRAD: '1',
+          QFT_RUNNER_MODEL_EVAL: '1',
+        },
+      });
