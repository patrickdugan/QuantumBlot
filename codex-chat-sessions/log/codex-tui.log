+      let stdout = '';
+      let stderr = '';
+      proc.stdout.on('data', (data) => {
+        const text = data.toString();
+        stdout += text;
+        process.stdout.write(text);
+      });
+      proc.stderr.on('data', (data) => {
+        const text = data.toString();
+        stderr += text;
+        process.stderr.write(text);
+      });
+
+      proc.on('close', (code) => {
+        if (code !== 0) {
+          rejectPromise(new Error(`Python script failed with code ${code}\n${stderr}`));
+        } else {
