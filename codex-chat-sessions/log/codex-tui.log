+"""Versioned symbol registry for SC1028.
+
+SC1028 is a 1028-bit symbolic DSL. This module defines the stable symbol-to-bit
+mapping used by the encoder/decoder.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, Iterable, List
+
+SC1028_VERSION = "1.0.0"
+SC1028_BITS = 1028
+SC1028_STORAGE_BITS = 1032
+SC1028_STORAGE_BYTES = 129
+
+
+@dataclass(frozen=True)
+class Primitive:
+    name: str
+    bit: int
+    description: str
+
+
+_PRIMITIVE_ROWS = [
+    # Meta / schema
+    ("meta.schema_v1", 0, "SC1028 schema version 1 marker"),
+    ("meta.run_start", 1, "Run started"),
+    ("meta.run_end", 2, "Run completed"),
+    ("meta.chunk_boundary", 3, "Chunk boundary marker"),
+    ("meta.provenance_tag_enabled", 4, "Explicit provenance tag enabled"),
+    ("meta.seed_present", 5, "Seed supplied for run"),
+    # Action type
+    ("action.pca", 16, "PCA stage action"),
+    ("action.prep", 17, "Sparsify/prep stage action"),
+    ("action.prerank", 18, "Prerank stage action"),
+    ("action.qft", 19, "QFT execution stage action"),
+    ("action.decode", 20, "Decode stage action"),
+    ("action.emit", 21, "Emit/payload stage action"),
+    ("action.single_command", 22, "Single-stage CLI command"),
+    ("action.full_pipeline", 23, "Full pipeline command"),
+    ("action.tool_boundary", 24, "Tool invocation boundary"),
+    # Tool / implementation surface
+    ("tool.qft_pca", 64, "qft_pca helper used"),
+    ("tool.layered_qft", 65, "layered_qft helper used"),
+    ("tool.prerank_wedge", 66, "prerank_wedge helper used"),
+    ("tool.decode_qft_hist", 67, "decode_qft_hist helper used"),
+    ("tool.emit_prompt", 68, "emit_prompt helper used"),
+    ("tool.fallback_decoder", 69, "Fallback decoder path used"),
+    ("tool.subprocess_python", 70, "Subprocess python tool boundary"),
+    # Termination / control flow
+    ("term.chunk_ok", 128, "Chunk completed successfully"),
+    ("term.chunk_failed", 129, "Chunk failed"),
+    ("term.chunk_skipped", 130, "Chunk skipped"),
+    ("term.episode_done", 131, "Episode complete"),
+    ("term.run_done", 132, "Run complete"),
+    ("term.watchdog_exit", 133, "Watchdog-triggered clean exit"),
+    ("term.max_steps_hit", 134, "Step cap reached"),
+    ("term.max_episodes_hit", 135, "Episode cap reached"),
+    # Uncertainty
+    ("uncert.entropy_available", 192, "Entropy metric available"),
+    ("uncert.entropy_high", 193, "High entropy condition"),
+    ("uncert.entropy_low", 194, "Low entropy condition"),
+    ("uncert.topk_gap_available", 195, "Top-k gap metric available"),
+    ("uncert.topk_gap_low", 196, "Low confidence top-k gap"),
+    ("uncert.topk_gap_high", 197, "High confidence top-k gap"),
+    # Constraint checks
+    ("constraint.check_available", 256, "Constraint checks were evaluated"),
+    ("constraint.pass", 257, "Constraints passed"),
+    ("constraint.fail", 258, "Constraints failed"),
+    ("constraint.row_in_range", 259, "Row bounds check passed"),
+    ("constraint.input_exists", 260, "Input existence check passed"),
+    # Loop / cycle heuristics
+    ("loop.repeat_obs_hash", 320, "Observation hash repeated in recent window"),
+    ("loop.repeat_action_hash", 321, "Action hash repeated in recent window"),
+    ("loop.short_cycle", 322, "Detected short repeating cycle"),
+    # Inference/runtime mode
+    ("mode.inference_only", 384, "Inference-only mode in effect"),
+    ("mode.eval_applied", 385, "eval() mode applied to model(s)"),
+    ("mode.no_grad_applied", 386, "no_grad context active"),
+    # Resources / runtime safety
+    ("resource.rss_sampled", 448, "RSS sampled"),
+    ("resource.rss_watchdog_ok", 449, "RSS below watchdog threshold"),
+    ("resource.rss_watchdog_tripped", 450, "RSS watchdog triggered"),
+    ("resource.flush_per_chunk", 451, "Telemetry flushed at chunk boundary"),
+    ("resource.lockfile_acquired", 452, "Single-instance lock acquired"),
+]
+
+
+PRIMITIVES: List[Primitive] = [Primitive(name=n, bit=b, description=d) for (n, b, d) in _PRIMITIVE_ROWS]
+
+SYMBOL_TO_BIT: Dict[str, int] = {p.name: p.bit for p in PRIMITIVES}
+BIT_TO_SYMBOL: Dict[int, str] = {p.bit: p.name for p in PRIMITIVES}
+
+
+def validate_registry() -> None:
+    if len(SYMBOL_TO_BIT) != len(PRIMITIVES):
+        raise ValueError("Duplicate symbol names in SC1028 registry.")
+    if len(BIT_TO_SYMBOL) != len(PRIMITIVES):
+        raise ValueError("Duplicate bit assignments in SC1028 registry.")
+    for primitive in PRIMITIVES:
+        if primitive.bit < 0 or primitive.bit >= SC1028_BITS:
+            raise ValueError(f"Bit index out of range for {primitive.name}: {primitive.bit}")
+
+
+def known_symbols() -> List[str]:
+    return sorted(SYMBOL_TO_BIT.keys())
+
+
+def resolve_bits(symbols: Iterable[str], strict: bool = True) -> List[int]:
+    bits: List[int] = []
+    for symbol in symbols:
+        bit = SYMBOL_TO_BIT.get(symbol)
+        if bit is None:
+            if strict:
+                raise KeyError(f"Unknown SC1028 symbol: {symbol}")
+            continue
+        bits.append(bit)
+    return bits
+
+
+validate_registry()
+
